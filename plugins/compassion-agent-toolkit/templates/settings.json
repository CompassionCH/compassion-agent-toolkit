{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": false
  },
  "permissions": {
    "deny": [
      "Read(//**/odoo.conf)",
      "Read(//**/.odoorc)",
      "Read(~/.pgpass)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(*dropdb *)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*DROP TABLE*)",
      "Bash(*drop table*)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(*odoo-bin *-u *)",
      "Bash(*odoo-bin *--update*)",
      "Bash(*odoo-bin *-i *)",
      "Bash(*odoo-bin *--init*)",
      "Bash(odoo *-u *)",
      "Bash(odoo *--update*)",
      "Bash(*psql *)"
    ]
  },
  "extraKnownMarketplaces": {
    "compassion": {
      "source": {
        "source": "github",
        "repo": "CompassionCH/compassion-agent-toolkit"
      }
    }
  },
  "enabledPlugins": {
    "compassion-agent-toolkit@compassion": true
  }
}
