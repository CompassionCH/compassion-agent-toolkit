{
  "managedSourcesBehavior": "merge",
  "attribution": {
    "commit": ""
  },
  "extraKnownMarketplaces": {
    "compassion": {
      "source": {
        "source": "github",
        "repo": "CompassionCH/compassion-agent-toolkit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "compassion-agent-toolkit@compassion": false
  },
  "permissions": {
    "deny": [
      "Read(//**/odoo.conf)",
      "Read(//**/.odoorc)",
      "Read(~/.pgpass)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/id_rsa)",
      "Read(~/.ssh/id_ed25519)",
      "Read(~/.ssh/id_ecdsa)",
      "Read(~/.ssh/id_dsa)",
      "Read(~/.ssh/id_ed25519_sk)",
      "Read(~/.ssh/id_ecdsa_sk)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)"
    ]
  }
}
